{
  "productName": "PREV Player",
  "version": "1.6.0",
  "identifier": "com.prev-player.app",
  "build": {
    "beforeDevCommand": "npm run vite-dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run vite-build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyOEQyNEM1RTQyRjQ0ODkKUldTSlJDL2t4U1NOY3JXUDgzZkF0THFkemROMmNYbnhiQkdrSXBWdEF4aEZNd0l3UStBa1lXUDEK",
      "endpoints": [
        "https://github.com/Arouzefst1/Prev-Player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["prevplayer"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/mpv/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["mkv", "mk3d", "mp4", "m4v", "mov", "webm", "avi", "divx", "wmv", "asf", "flv", "f4v", "ts", "mts", "m2ts", "vob", "evo", "mpg", "mpeg", "m2v", "mxf", "ogv", "ogg", "ogm", "rm", "rmvb", "3gp", "3g2", "hevc", "h265", "265", "h264", "264", "ivf", "obu", "vvc", "266"],
        "name": "Video File",
        "description": "Video files",
        "role": "Viewer"
      },
      {
        "ext": ["ac3", "eac3", "ec3", "thd", "mlp", "dts", "dtshd", "flac", "alac", "wav", "w64", "aiff", "aif", "ape", "wv", "tak", "tta", "dsf", "dff", "caf", "mp3", "mp2", "m4a", "m4b", "aac", "opus", "oga", "weba", "wma", "mpc", "mka"],
        "name": "Audio File",
        "description": "Audio files",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "PREV Player",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
